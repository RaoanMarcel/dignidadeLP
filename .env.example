# Copie para .env (local) e configure as mesmas variáveis no painel do Netlify.
# NUNCA commite o .env nem a SERVICE_ROLE_KEY.

# Servidor (SSR / funções)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # só no servidor, nunca no front-end

# Front-end (Vite)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
